<UserControl x:Class="KznNotch.Views.MediaCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:KznNotch.Views">
  <StackPanel>
    <Grid Margin="0,4,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="124"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="Album" Width="108" Height="108" CornerRadius="22" Background="{DynamicResource NavigationBrush}" HorizontalAlignment="Left"><Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Cover}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,108,108" RadiusX="22" RadiusY="22"/></Image.Clip></Image></Grid></Border>
      <Grid x:Name="TrackInfo" Grid.Column="1" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><views:PlaybackIndicator Grid.Column="1" IsPlaying="{Binding Playing}" MotionMilliseconds="{Binding DataContext.Host.Settings.Current.AnimationMilliseconds, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Wiedergabestatus" VerticalAlignment="Center"/></Grid>
        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="17" LineHeight="23" MaxHeight="46" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
        <TextBlock Grid.Row="2" Text="{Binding Artist}" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Artist}"/>
      </Grid>
    </Grid>
    <Grid Height="20" Background="Transparent" MouseLeftButtonDown="Seek_Click" Cursor="Hand" ToolTip="Wiedergabeposition ändern"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Background="{DynamicResource BarTrackBrush}" Foreground="{DynamicResource BarBrush}" Height="{DynamicResource BarThickness}" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <Grid Margin="0,0,0,12"><TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Total}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/></Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Style="{StaticResource IslandIconButton}" Content="&#xE892;" FontSize="20" Foreground="{DynamicResource TextBrush}" Width="48" Height="48" Command="{Binding PreviousCommand}" ToolTip="Vorheriger Titel" AutomationProperties.Name="Vorheriger Titel"/>
      <Button Style="{StaticResource IslandPrimaryButton}" Content="{Binding PlayGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Width="60" Height="48" Padding="0" Margin="24,0" Command="{Binding ToggleCommand}" ToolTip="Wiedergabe / Pause" AutomationProperties.Name="Wiedergabe oder Pause"/>
      <Button Style="{StaticResource IslandIconButton}" Content="&#xE893;" FontSize="20" Foreground="{DynamicResource TextBrush}" Width="48" Height="48" Command="{Binding NextCommand}" ToolTip="Nächster Titel" AutomationProperties.Name="Nächster Titel"/>
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel>
</UserControl>
