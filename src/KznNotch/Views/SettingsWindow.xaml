        <Border Style="{StaticResource SettingsGroup}"><ItemsControl ItemsSource="{Binding Colors}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="48" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" Background="{Binding Swatch}" BorderBrush="{DynamicResource StrokeBrush}" Click="PickColor_Click" Padding="0" Margin="0,0,8,0" ToolTip="Farbe auswählen" AutomationProperties.Name="{Binding Label}"/><TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="BorderBrush" Value="#CE4338"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
