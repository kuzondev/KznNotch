      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Position" Tag="&#xE81D;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
