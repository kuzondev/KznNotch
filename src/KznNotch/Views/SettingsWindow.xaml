          <WrapPanel><Button Content="Windows-Freigabe erlauben" Command="{Binding Host.Discord.PermissionCommand}" Margin="0,0,8,6" Visibility="{Binding Host.Discord.NeedsPermission, Converter={StaticResource BoolVisibility}}"/><Button Content="Datenschutzeinstellungen" Command="{Binding Host.Discord.WindowsSettingsCommand}" Margin="0,0,8,6" Visibility="{Binding Host.Discord.NeedsPermission, Converter={StaticResource BoolVisibility}}"/><Button Content="Discord öffnen" Command="{Binding Host.Discord.OpenCommand}" Margin="0,0,0,6"/></WrapPanel>
        </StackPanel></Border>
        <TextBlock Text="Windows verlangt einmalig deine Zustimmung. Nachrichten bleiben ausschließlich im Arbeitsspeicher. Voice-Channel und Discord-Mute/Deafen stehen ohne autorisierte Anbindung nicht zur Verfügung." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <Border Style="{StaticResource SettingsGroup}"><HeaderedContentControl Style="{StaticResource LastRow}" Header="Spotify &amp; Medien" Tag="Automatisch über Windows-Mediensitzungen verbunden."><Button Content="Öffnen" Click="Spotify_Click" VerticalAlignment="Center" AutomationProperties.Name="Spotify öffnen"/></HeaderedContentControl></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="GamingTab" Header="Spielmodus" Tag="&#xE7FC;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
        <TextBlock Text="Deine Notch passt sich dem aktiven Spiel an." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
        <Border Style="{StaticResource SettingsGroup}"><StackPanel>
          <HeaderedContentControl Style="{StaticResource Row}" Header="Verhalten im Spiel" Tag="Minimalistisch zeigt nur die Uhr, ohne Hover-Menü und vollständig klickdurchlässig. Aus blendet die Notch während des Spiels vollständig aus. Aktiv lässt sie unverändert. Außerhalb des Spiels gilt immer der Normalbetrieb."><ComboBox SelectedIndex="{Binding GamingModeIndex}" MinWidth="190" AutomationProperties.Name="Verhalten im Spiel"><ComboBoxItem Content="Aktiv · Normalbetrieb"/><ComboBoxItem Content="Minimalistisch"/><ComboBoxItem Content="Aus während des Gamings"/><ComboBoxItem Content="FPS · Bildrate &amp; Frametime"/></ComboBox></HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource LastRow}" Header="Ecke" Tag="Für den minimalistischen Modus"><ComboBox SelectedIndex="{Binding GamingCornerIndex}" MinWidth="140" AutomationProperties.Name="Ecke im Spiel"><ComboBoxItem Content="Oben rechts"/><ComboBoxItem Content="Oben links"/><ComboBoxItem Content="Unten rechts"/><ComboBoxItem Content="Unten links"/></ComboBox></HeaderedContentControl>
        </StackPanel></Border>
        <TextBlock Text="{Binding Host.Gaming.Status}" FontSize="12" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
        <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Echte FPS &amp; Frametime" FontWeight="SemiBold"/><TextBlock Text="{Binding Host.Fps.Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite"/><Button Content="FPS-Messung starten" Command="{Binding Host.Fps.StartCommand}"/><TextBlock Text="PresentMon benötigt Windows-Messberechtigungen. Diese Version fordert keine erhöhten Rechte an. Ohne vorhandenen Zugriff erscheinen keine FPS-Werte. Exklusives Vollbild kann die Anzeige verdecken." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="Automatisch erkannte Spiele" Style="{StaticResource GroupTitle}"/>
        <TextBlock Text="Steam-, Epic-, Xbox- und GOG-Bibliotheken werden automatisch gelesen und jede Minute aktualisiert. Neu erkannte Vollbildspiele werden lokal gemerkt. Browser und Launcher sind ausgeschlossen." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Host.Games.Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><Button Content="Bibliotheken aktualisieren" Command="{Binding Host.Games.RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Host.Games.Games}" AlternationCount="1000000"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" Padding="0,10"><Border.BorderThickness><MultiBinding Converter="{StaticResource RowSeparatorConverter}"><Binding RelativeSource="{RelativeSource AncestorType={x:Type ContentPresenter}}" Path="(ItemsControl.AlternationIndex)"/><Binding RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" Path="Items.Count"/></MultiBinding></Border.BorderThickness><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock Text="{Binding RootPath}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="PluginsTab" Header="Kzn Studio" Tag="&#xE943;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
        <TextBlock Text="Deine Notch. Dein .kzn-Code." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Lokale Plugin-Bibliothek mit Editor und Vorschau. Ein aktives Plugin ersetzt die geschlossene Anzeige. Plugins werden über die eigenen Buttons gespeichert." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="{Binding Host.Plugins.ActiveLabel}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Meine Plugins" FontWeight="SemiBold" Margin="0,10"/><ListBox ItemsSource="{Binding Host.Plugins.Library}" SelectedItem="{Binding Host.Plugins.Selected}" Height="132" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Lokale Plugin-Bibliothek"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
        <WrapPanel Margin="0,0,0,10"><Button Content="Neue Uhr" Command="{Binding Host.Plugins.NewCommand}" CommandParameter="clock" Margin="0,0,6,6"/><Button Content="Medien-Vorlage" Command="{Binding Host.Plugins.NewCommand}" CommandParameter="media" Margin="0,0,6,6"/><Button Content="Fokus-Vorlage" Command="{Binding Host.Plugins.NewCommand}" CommandParameter="focus" Margin="0,0,6,6"/><Button Content="Bild statt Uhr" Tag="replace" Click="PluginImage_Click" Margin="0,0,6,6"/></WrapPanel>
        <WrapPanel Margin="0,0,0,10"><Button Content=".kzn importieren" Click="ImportPlugin_Click" Margin="0,0,6,6"/><Button Content=".kzn exportieren" Click="ExportPlugin_Click" Margin="0,0,6,6"/><Button Content="Bild einfügen" Click="PluginImage_Click" Margin="0,0,6,6"/></WrapPanel>
        <TextBlock Text="Code" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/><TextBox x:Name="PluginEditor" VerticalContentAlignment="Top" Text="{Binding Host.Plugins.Source, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="250" FontFamily="Cascadia Code, Consolas" FontSize="13" Padding="12" AutomationProperties.Name="Kzn-Code-Editor"><TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Host.Plugins.PreviewCommand}"/><KeyBinding Key="S" Modifiers="Control" Command="{Binding Host.Plugins.SaveCommand}"/></TextBox.InputBindings></TextBox>
        <TextBlock Text="Strg+Enter: prüfen · Strg+S: Plugin speichern" Style="{StaticResource Muted}" Margin="0,6,0,10"/><WrapPanel><Button Content="Prüfen &amp; Vorschau" Command="{Binding Host.Plugins.PreviewCommand}" Margin="0,0,6,6"/><Button Content="Speichern" Command="{Binding Host.Plugins.SaveCommand}" Margin="0,0,6,6"/><Button Content="Speichern &amp; aktivieren" Style="{StaticResource AccentButton}" Command="{Binding Host.Plugins.ActivateCommand}" Margin="0,0,6,6"/><Button Content="Standardanzeige" Command="{Binding Host.Plugins.DisableCommand}" Margin="0,0,6,6"/></WrapPanel>
        <TextBlock Text="{Binding Host.Plugins.Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
        <Border Background="{DynamicResource IslandBackgroundBrush}" CornerRadius="20" MinHeight="64" Padding="12"><views:KznSurface Host="{Binding Host}" Document="{Binding Host.Plugins.PreviewDocument}" BaseDirectory="{Binding Host.Plugins.EditorDirectory}"/></Border>
        <Expander Header="Kzn 1 · Befehle &amp; Variablen" Margin="0,16,0,0"><TextBlock Text="kzn 1 · Dateiversion&#10;plugin &quot;Name&quot; · description &quot;Beschreibung&quot;&#10;target compact · geschlossene Notch&#10;font &quot;Segoe UI&quot; 14 · color &quot;#A8BDFF&quot;&#10;layout row / column · spacing 8&#10;text &quot;Hallo&quot; · clock &quot;HH:mm:ss&quot;&#10;image &quot;assets/logo.png&quot; 28&#10;button &quot;Fokus&quot; timer&#10;when media.playing / timer.running / gaming.active&#10;end&#10;&#10;Textvariablen: {clock}, {date}, {media.title}, {media.artist}, {timer}, {fps}.&#10;Aktionen: media, timer, system, todo, reminder, bluetooth, discord, fps, settings.&#10;Bilder bleiben im Plugin-Ordner. Beim Export den assets-Ordner mitgeben." TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="0,10"/></Expander>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Allgemein" Tag="&#xE713;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
        <TextBlock Text="Startverhalten, Benachrichtigungen und lokale Daten." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
        <Border Style="{StaticResource SettingsGroup}"><StackPanel><HeaderedContentControl Style="{StaticResource Row}" Header="Mit Windows starten"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.StartWithWindows}" AutomationProperties.Name="Mit Windows starten"/></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Row}" Header="Benachrichtigungen" Tag="Timer und Erinnerungen"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.Notifications}" AutomationProperties.Name="Windows Benachrichtigungen"/></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource LastRow}" Header="Compact klickdurchlässig" Tag="Öffnen danach über das Tray"><CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.ClickThroughCompact}" AutomationProperties.Name="Compact vollständig klickdurchlässig"/></HeaderedContentControl>
        </StackPanel></Border><TextBlock Text="Lokale Daten" Style="{StaticResource GroupTitle}"/>
        <TextBlock Text="Einstellungen, Aufgaben und Erinnerungen werden lokal in %AppData%\Kzn Notch gespeichert. Vorhandene Notchify-Daten werden beim Umstieg übernommen." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Host.Settings.StartupStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,10"><Button Content="Kzn Store öffnen" Click="Store_Click" Margin="0,0,8,0"/><Button Content="Windows-Autostart öffnen" Click="StartupSettings_Click"/></StackPanel>
        <Button Content="Nach Updates suchen" Click="Update_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,20"><Button Content="Datenordner öffnen" Click="Data_Click" Margin="0,0,8,0"/><Button Content="Zurücksetzen" Command="{Binding ResetCommand}"/></StackPanel>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CanvasBrush}"><Grid x:Name="SaveFooterContent" Margin="238,12,28,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/><Button Grid.Column="1" Content="Änderungen sichern" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Padding="16,6"/></Grid></Border>
  </Grid>
</Window>
