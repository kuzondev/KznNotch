  <Grid x:Name="SettingsRoot" Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition/><RowDefinition Height="62"/></Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabItem Header="Darstellung" Tag="&#xE790;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
