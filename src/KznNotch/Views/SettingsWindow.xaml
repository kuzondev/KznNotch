      <TabItem x:Name="DesignTab" Header="Design" Tag="&#xE790;"><ScrollViewer Foreground="{DynamicResource TextBrush}"><StackPanel TextElement.Foreground="{DynamicResource TextBrush}" Margin="0,0,6,24">
