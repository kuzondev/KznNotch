        <TextBlock Text="Funktionen" Style="{StaticResource GroupTitle}"/><Border Style="{StaticResource SettingsGroup}" Padding="0,4"><ListBox x:Name="WidgetList" ItemsSource="{Binding Widgets}" AlternationCount="1000000" ItemTemplate="{StaticResource WidgetRow}" AllowDrop="True" PreviewMouseLeftButtonDown="Layout_MouseDown" PreviewMouseMove="Layout_MouseMove" DragOver="Layout_DragOver" Drop="Layout_Drop"/></Border>
