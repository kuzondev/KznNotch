<UserControl x:Class="KznNotch.Views.DiscordCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
  <StackPanel>
    <DockPanel Margin="0,0,0,8"><TextBlock Text="Discord" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
    <TextBlock Text="{Binding RunningLabel}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding NotificationItems, ElementName=Root}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Sender}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Style="{StaticResource Muted}"/></Grid>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding EmptyLabel}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding HasNotifications, Converter={StaticResource InverseVisibility}}"/>
    <Button Content="Windows-Freigabe erlauben" Command="{Binding PermissionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding NeedsPermission, Converter={StaticResource BoolVisibility}}"/>
    <Button Content="Discord öffnen" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel>
</UserControl>
