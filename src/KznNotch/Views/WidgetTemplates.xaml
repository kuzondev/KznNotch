<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:w="clr-namespace:KznNotch.Widgets" xmlns:views="clr-namespace:KznNotch.Views">
  <DataTemplate DataType="{x:Type w:MediaWidget}"><Border Style="{StaticResource Card}"><views:MediaCard DataContext="{Binding Model}"/></Border></DataTemplate>
  <DataTemplate DataType="{x:Type w:TimerWidget}">
    <Border Style="{StaticResource Card}" DataContext="{Binding Model}"><StackPanel>
      <TextBlock Text="{Binding Display}" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource TimerBrush}" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Foreground="{DynamicResource TimerBrush}" Margin="0,0,0,12"/>
      <UniformGrid Columns="3" Margin="-3,0,-3,10"><Button Style="{StaticResource IslandButton}" Content="5 min" Command="{Binding PresetCommand}" CommandParameter="5" Margin="3,0"/><Button Style="{StaticResource IslandButton}" Content="10 min" Command="{Binding PresetCommand}" CommandParameter="10" Margin="3,0"/><Button Style="{StaticResource IslandButton}" Content="25 min" Command="{Binding PresetCommand}" CommandParameter="25" Margin="3,0"/></UniformGrid>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="Minuten" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Eigene Dauer in Minuten"/><Button Grid.Column="2" Style="{StaticResource IslandButton}" Content="Dauer starten" Command="{Binding CustomCommand}" Margin="8,0"/><Button Grid.Column="3" Style="{StaticResource IslandIconButton}" Content="&#xE777;" Command="{Binding ResetCommand}" ToolTip="Zurücksetzen" AutomationProperties.Name="Timer zurücksetzen"/></Grid>
      <UniformGrid Columns="2"><Button Style="{StaticResource IslandPrimaryButton}" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Margin="0,0,4,0"/><Button Style="{StaticResource IslandButton}" Content="Pomodoro · 25 / 5" Command="{Binding PomodoroCommand}" Margin="4,0,0,0" ToolTip="25 Minuten Fokus, 5 Minuten Pause"/></UniformGrid>
    </StackPanel></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:SystemStatsWidget}">
    <Border Style="{StaticResource Card}" DataContext="{Binding Model}"><StackPanel>
      <TextBlock Text="System" Style="{StaticResource SectionTitle}"/>
      <DockPanel Margin="0,0,0,7"><TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CpuLabel}" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding Cpu, Mode=OneWay}" Margin="0,0,0,10"/>
      <DockPanel Margin="0,0,0,7"><TextBlock Text="RAM" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding RamLabel}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Margin="0,0,0,10" Foreground="{DynamicResource BarBrush}"/>
      <DockPanel Margin="0,0,0,7"><TextBlock Text="GPU" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding GpuLabel}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
      <ProgressBar Value="{Binding Gpu, Mode=OneWay, TargetNullValue=0}" Margin="0,0,0,12" AutomationProperties.Name="GPU-Auslastung"/>
      <DockPanel Margin="0,0,0,8"><TextBlock Text="↓ Download" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Download}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
      <DockPanel><TextBlock Text="↑ Upload" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Upload}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
    </StackPanel></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:TodoWidget}">
    <Border Style="{StaticResource Card}" DataContext="{Binding Model}"><StackPanel>
      <TextBlock Text="Neue Aufgabe" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Neue Aufgabe"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Style="{StaticResource IslandPrimaryButton}" Content="Hinzufügen" Command="{Binding AddCommand}" Margin="8,0,0,0"/></Grid>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Priorität" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox Style="{StaticResource IslandComboBox}" SelectedIndex="{Binding NewPriority}" AutomationProperties.Name="Priorität"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Mittel"/><ComboBoxItem Content="Hoch"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fällig am · optional" Style="{StaticResource Muted}" Margin="0,0,0,6"/><DatePicker Style="{StaticResource IslandDatePicker}" SelectedDate="{Binding NewDue}" AutomationProperties.Name="Optionales Fälligkeitsdatum"/></StackPanel></Grid>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
      <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Completed}" AutomationProperties.Name="{Binding Title}"/><StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource IslandIconButton}" Content="&#xE711;" ToolTip="Aufgabe löschen" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Aufgabe löschen"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:ReminderWidget}">
    <Border Style="{StaticResource Card}" DataContext="{Binding Model}"><StackPanel>
      <TextBlock Text="Woran möchtest du erinnert werden?" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Neue Erinnerung" Margin="0,0,0,10"/>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Datum" Style="{StaticResource Muted}" Margin="0,0,0,6"/><DatePicker Style="{StaticResource IslandDatePicker}" SelectedDate="{Binding NewDate}" AutomationProperties.Name="Datum der Erinnerung"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Uhrzeit · HH:mm" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Uhrzeit HH:mm"/></StackPanel></Grid>
      <Button Style="{StaticResource IslandPrimaryButton}" Content="Erinnerung erstellen" Command="{Binding AddCommand}"/>
      <TextBlock Text="{Binding Error}" Foreground="#FFB2AD" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="Keine Erinnerungen geplant." Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
      <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IslandIconButton}" Content="&#xE711;" ToolTip="Erinnerung löschen" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Erinnerung löschen"/><StackPanel VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding DueLabel}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:BluetoothWidget}">
    <Border Style="{StaticResource Card}" DataContext="{Binding Model}"><StackPanel>
      <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IslandIconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Akkustände aktualisieren" AutomationProperties.Name="Akkustände aktualisieren"/><TextBlock Text="Geräte" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
      <ItemsControl ItemsSource="{Binding TrackedDevices}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding BatteryLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:DiscordWidget}">
    <Border Style="{StaticResource Card}"><views:DiscordCard DataContext="{Binding Model}" NotificationItems="{Binding Notifications}"/></Border>
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:FpsWidget}"><StackPanel DataContext="{Binding Model}"><TextBlock Text="{Binding GameLabel}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OverlayText}" FontSize="44" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding FrameLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,2,0,12"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Style="{StaticResource IslandButton}" Content="FPS-Messung starten" Command="{Binding StartCommand}"/></StackPanel></DataTemplate></ResourceDictionary>
