<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KznNotch</AssemblyName>
    <RootNamespace>KznNotch</RootNamespace>
    <Version>0.10.0</Version>
    <Product>Kzn Notch</Product>
    <Title>Kzn Notch</Title>
    <Description>Compact desktop companion for Windows 11</Description>
    <ApplicationIcon>Assets\kzn-notch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <Resource Include="Assets\kzn-notch.ico" />
  </ItemGroup>
  <ItemGroup><Content Include="Tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="Tools\PresentMon-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Project>
